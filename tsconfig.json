{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "apps/api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
