{
  "name": "solveflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "lint": "node scripts/check-boundaries.mjs && pnpm docs:check",
    "typecheck": "pnpm build:workspace && tsc --noEmit && pnpm --filter @solveflow/mobile typecheck",
    "build": "pnpm build:workspace && pnpm --filter @solveflow/mobile build && node scripts/check-build.mjs",
    "build:shared": "node scripts/prepare-mobile-agent.mjs && pnpm --filter \"@solveflow/client...\" --filter \"@solveflow/agent...\" -r build",
    "build:server": "pnpm --filter \"@solveflow/api...\" -r build",
    "build:workspace": "node scripts/prepare-mobile-agent.mjs && pnpm --filter \"!@solveflow/mobile\" -r build",
    "build:mobile": "pnpm build:shared && pnpm --filter @solveflow/mobile build && node scripts/check-mobile-build.mjs",
    "build:web": "pnpm build:shared && pnpm --filter @solveflow/mobile build:web",
    "test": "pnpm build:workspace && vitest run --maxWorkers=2",
    "test:unit": "pnpm test --project unit",
    "test:offline": "pnpm test --project offline",
    "config:check": "pnpm --filter @solveflow/contracts build && pnpm --filter @solveflow/config build && node --env-file-if-exists=.env scripts/check-config.mjs",
    "probe:offline": "pnpm build:server && node scripts/probe.mjs",
    "probe:live": "pnpm build:server && node --env-file-if-exists=.env scripts/probe.mjs --live",
    "probe:ledger:init": "pnpm build:server && node scripts/probe.mjs --init-ledger",
    "test:integration": "pnpm build:server && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --config playwright.functional.config.ts",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "local:setup": "node scripts/setup-local.mjs",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "db:migrate": "pnpm build:server && node --env-file=.env scripts/db-migrate.mjs",
    "dev": "pnpm build:shared && pnpm --filter @solveflow/mobile dev",
    "dev:demo": "pnpm build:workspace && node scripts/dev.mjs --demo",
    "start": "node scripts/web-server.mjs",
    "start:demo": "node scripts/dev.mjs --production --demo",
    "config:migrate": "pnpm --filter @solveflow/contracts build && pnpm --filter @solveflow/config build && node scripts/migrate-model-config.mjs",
    "m1:preflight": "pnpm build:server && node scripts/m1-preflight.mjs",
    "test:m1:live": "pnpm build:server && node scripts/m1-live-acceptance.mjs",
    "mobile:dev": "pnpm dev",
    "mobile:prebuild": "pnpm build:shared && pnpm --filter @solveflow/mobile prebuild",
    "mobile:android": "pnpm build:shared && pnpm --filter @solveflow/mobile android",
    "mobile:ios": "pnpm build:shared && pnpm --filter @solveflow/mobile ios",
    "mobile:doctor": "node scripts/native-build.mjs check",
    "mobile:apk": "node scripts/native-build.mjs apk",
    "test:android:pager": "node scripts/test-android-pager.mjs",
    "test:verifier:regression": "node scripts/test-verifier-regression.mjs",
    "server:dev": "pnpm build:workspace && node scripts/dev.mjs",
    "server:start": "node scripts/dev.mjs --production",
    "docs:check": "node scripts/check-project-docs.mjs",
    "docs:test": "node --test scripts/test-project-docs.mjs",
    "deps:audit": "pnpm audit --audit-level=low",
    "test:android:storage:build": "node scripts/build-android-storage-probe.mjs",
    "test:android:storage": "node scripts/test-android-storage.mjs",
    "test:ios:smoke": "node scripts/test-ios-simulator.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
