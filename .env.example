# SolveFlow server-only configuration. Copy locally; never commit .env.
# Offline is the default. Setting a key alone does NOT enable paid calls.
SOLVEFLOW_LIVE_CALLS=false
# Local cumulative spending: unlimited (default), or a positive RMB amount.
# Unlimited mode does not read, create, reset or append the fee journal.
SOLVEFLOW_LIVE_BUDGET_RMB=unlimited

# Provider-neutral server configuration. Fill these from your provider docs.
# Currently supported protocol: OpenAI-compatible chat completions.
# PROVIDER is an arbitrary label; if blank, the BASE_URL hostname is used.
SOLVEFLOW_LLM_PROVIDER=
SOLVEFLOW_LLM_API=openai-completions
SOLVEFLOW_LLM_BASE_URL=
SOLVEFLOW_LLM_API_KEY=
SOLVEFLOW_SOLVER_MODEL=
SOLVEFLOW_VERIFIER_MODEL=

# Metadata declarations from the chosen provider; no model-specific defaults.
# Capabilities still need real integration verification before claiming support.
SOLVEFLOW_LLM_SUPPORTS_IMAGES=false
SOLVEFLOW_LLM_SUPPORTS_TOOLS=false
SOLVEFLOW_LLM_REASONING=false
SOLVEFLOW_SOLVER_CONTEXT_WINDOW=
SOLVEFLOW_SOLVER_MAX_OUTPUT_TOKENS=
SOLVEFLOW_VERIFIER_CONTEXT_WINDOW=
SOLVEFLOW_VERIFIER_MAX_OUTPUT_TOKENS=
# Requested output limits. Capacity remains the default reservation policy.
SOLVEFLOW_SOLVER_MAX_TOKENS=4096
SOLVEFLOW_VERIFIER_MAX_TOKENS=4096
# request-limit ONLY after reviewing that the configured token field bounds ALL
# billed output (including reasoning). Unknown gateway semantics: keep capacity.
SOLVEFLOW_SOLVER_OUTPUT_BUDGET_MODE=capacity
SOLVEFLOW_VERIFIER_OUTPUT_BUDGET_MODE=capacity
# Optional protocol options (strict JSON); use max_completion_tokens if required.
SOLVEFLOW_LLM_COMPAT={"maxTokensField":"max_tokens","supportsStore":false,"supportsDeveloperRole":false,"supportsReasoningEffort":false}

# Optional per-role overrides: SOLVEFLOW_SOLVER_* / SOLVEFLOW_VERIFIER_*
# PROVIDER, API, BASE_URL, API_KEY, COMPAT, SUPPORTS_IMAGES, SUPPORTS_TOOLS, REASONING.
# Changing a role's provider or URL requires that role's own API_KEY.

# Legacy LLM/DMX HARD_QUOTA variables are accepted for migration only.
# They no longer enable or block model requests; provider billing is external.
# Reviewed worst-case RMB per million tokens, including billable reasoning.
# Convert non-RMB pricing conservatively. Empty means blocked; 0 means verified free.
SOLVEFLOW_SOLVER_INPUT_RMB_PER_MTOK=
SOLVEFLOW_SOLVER_OUTPUT_RMB_PER_MTOK=
SOLVEFLOW_VERIFIER_INPUT_RMB_PER_MTOK=
SOLVEFLOW_VERIFIER_OUTPUT_RMB_PER_MTOK=
# Add per-request fees if applicable; complex pricing needs a reviewed upper bound.
SOLVEFLOW_SOLVER_REQUEST_FEE_RMB=0
SOLVEFLOW_VERIFIER_REQUEST_FEE_RMB=0

# M1 local infrastructure. Run pnpm local:setup to generate missing local
# passwords/URL/cookie secret without changing existing model settings.
SOLVEFLOW_APP_DATABASE_URL=
SOLVEFLOW_APP_DB_PASSWORD=
SOLVEFLOW_APP_S3_ENDPOINT=http://127.0.0.1:19000
SOLVEFLOW_APP_S3_REGION=us-east-1
SOLVEFLOW_APP_S3_BUCKET=solveflow-private
SOLVEFLOW_APP_S3_ACCESS_KEY=solveflow-local
SOLVEFLOW_APP_S3_SECRET_KEY=
SOLVEFLOW_APP_COOKIE_SECRET=
SOLVEFLOW_APP_ORIGIN=http://127.0.0.1:3100
SOLVEFLOW_APP_API_PORT=3101
# disabled: upload/save only; demo: explicit fixture; live: same M0 budget gates.
SOLVEFLOW_APP_MODE=disabled
