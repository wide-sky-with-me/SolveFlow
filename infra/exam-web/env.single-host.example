EXAM_RELEASE=local-review
EXAM_DOMAIN=exams.example.com
EXAM_CONFIG_FILE=/absolute/private/exam-config.json
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_PASSWORD
EXAM_API_PORT=3191
EXAM_HTTP_PORT=80
EXAM_HTTPS_PORT=443
EXAM_STORAGE_CA_FILE=/absolute/private/storage-ca.crt
EXAM_STORAGE_CERT_FILE=/absolute/private/storage-server.crt
EXAM_STORAGE_KEY_FILE=/absolute/private/storage-server.key
EXAM_STORAGE_CONFIG_FILE=/absolute/private/storage-identities.json
# Optional: reuse an existing public certificate, with a matching renewal job.
# EXAM_TLS_DIR=/absolute/private/tls
# EXAM_ACME_WEBROOT=/absolute/private/acme-webroot
